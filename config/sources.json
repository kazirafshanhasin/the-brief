      "sourcecountry:india sourcelang:english",
      "sourcecountry:kenya sourcelang:english",
      "sourcecountry:philippines sourcelang:english",
      "sourcecountry:brazil",
      "sourcecountry:mexico",
      "sourcecountry:indonesia",
      "(earthquake OR tsunami OR cyclone OR hurricane OR \"state of emergency\") sourcelang:english"

# Copy to .env for local runs:  npm run run:local --workspace @brief/pipeline
# In GitHub Actions these come from repository secrets/variables instead.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# AI summaries. "none" publishes headline-only entries (no AI cost).
#   anthropic → Anthropic Messages API (AI_BASE_URL defaults to https://api.anthropic.com)
#   openai    → any OpenAI-compatible /chat/completions endpoint (OpenAI, Google Gemini's
#               OpenAI-compatible endpoint, OpenRouter, Groq, DeepSeek …) — set AI_BASE_URL.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Spend guards. One call ≈ one summary (a rejected draft costs a second call).
AI_DAILY_CALL_CAP=400
MAX_SUMMARIES_PER_RUN=40

# Extra summary languages for major stories (importance ≥ 4), comma-separated: bn,hi,ar
TRANSLATE_LANGUAGES=

# Identify your crawler to publishers, with a contact address or URL.
BOT_USER_AGENT=TheBriefBot/0.1 (+https://your-site.example/about)
